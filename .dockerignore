# Docker ignore file
# Exclude unnecessary files from Docker build context

# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# Scripts (not needed in container)
*.sh
*.ps1

# Original file (not needed in container)
user_display_original.py
user_display_current.py
prompt.txt
